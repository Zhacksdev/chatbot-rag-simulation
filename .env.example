# Ambil API key di https://console.groq.com/keys
GROQ_API_KEY=gsk_isi_api_key_groq_kalian_disini

# Model Groq. Kalau model ini mati, kode otomatis coba model cadangan.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=800

# Jumlah produk maksimal yang dikirim ke LLM sebagai konteks
RAG_TOP_K=8

# Port dev server lokal (Vercel tidak memakai ini)
PORT=3000

# Hanya untuk gateway WhatsApp. Kosongkan kalau Chrome terpasang di lokasi
# standar — kode akan mencarinya sendiri.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Nomor WhatsApp tujuan tombol "Pesan" di website, format 62xxxxxxxxxx.
# Isi dengan nomor yang dipakai gateway WhatsApp.
WA_NUMBER=62800000000
